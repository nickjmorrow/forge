# Copy to .env (gitignored) and fill in. scripts/generate-project.sh reads it when generating the Xcode project.

# Apple Developer team ID, needed only for iOS device builds (signing, HealthKit, Live Activities).
DEVELOPMENT_TEAM=

# The variables below are not read from .env: set them in your shell or MCP client config when you need them.
# Database file for the forge CLI, the MCP server and the Mac app. Default: ~/Library/Application Support/Forge/forge.sqlite
# FORGE_DB=/path/to/forge.sqlite
# Hevy API key for `forge import-hevy` (or use --from-dir with exported JSON instead).
# HEVY_API_KEY=your-hevy-api-key
# Path to the forge binary for the MCP server. Default: forge on PATH, then ~/.local/bin/forge
# FORGE_BIN=/path/to/forge
# Set to 0 to stop the MCP server running `forge sync` around each tool call. Default: 1
# FORGE_AUTOSYNC=1
